# Reference for what install.sh writes to .env on first run.
# You normally don't need to copy this file by hand — install.sh generates
# strong random defaults for everything below if .env doesn't exist.
# Override individual values by exporting them before running install.sh.

# Postgres
POSTGRES_PASSWORD=changeme-postgres
JWT_SECRET=changeme-jwt-min-32-chars-please-change

# Supabase self-host (anon + service-role JWTs signed with JWT_SECRET).
# install.sh generates these automatically.
ANON_KEY=changeme-anon-jwt
SERVICE_ROLE_KEY=changeme-service-jwt

# Bearer tokens
INGEST_API_KEY=changeme-ingest-bearer
MCP_API_KEY=changeme-mcp-bearer

# Login-user passwords (consumed by install.sh's role-creation step).
INGEST_USER_PASSWORD=changeme-ingest-pw
READ_USER_PASSWORD=changeme-read-pw

# Connection strings (composed from the above; rarely overridden directly).
INGEST_DATABASE_URL=postgresql://ingest_user:changeme-ingest-pw@db:5432/postgres
MCP_DATABASE_URL=postgresql://read_user:changeme-read-pw@db:5432/postgres
MCP_GYM_WRITER_URL=postgresql://gym_writer_user:changeme-gym-pw@db:5432/postgres
MCP_DIET_WRITER_URL=postgresql://diet_writer_user:changeme-diet-pw@db:5432/postgres

# MCP HTTP port (must match the tailscale serve mapping)
MCP_PORT=3737
